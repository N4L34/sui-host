[Unit]
Description=Monitoring: metrics, logs, alerts
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=sui
SupplementaryGroups=docker
WorkingDirectory=/opt/monitoring
ExecStartPre=/bin/bash -c '/usr/bin/docker network inspect monitoring >/dev/null 2>&1 || /usr/bin/docker network create monitoring'
ExecStartPre=/usr/bin/python3 /opt/monitoring/scripts/discover.py
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
