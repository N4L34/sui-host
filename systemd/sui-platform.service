[Unit]
Description=Sui platform: metrics, logs, alerts
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=sui
SupplementaryGroups=docker
WorkingDirectory=/home/sui/sui-host
ExecStartPre=/bin/bash -c '/usr/bin/docker network inspect sui >/dev/null 2>&1 || /usr/bin/docker network create sui'
ExecStartPre=/usr/bin/python3 /home/sui/sui-host/scripts/discover.py
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
