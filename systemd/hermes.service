[Unit]
Description=Hermes Agent Telegram gateway
After=docker.service monitoring.service
Requires=docker.service monitoring.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=sui
SupplementaryGroups=docker
WorkingDirectory=/home/sui/sui-host/hermes
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
