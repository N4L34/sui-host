+// SPDX-License-Identifier: GPL-3.0-or-later
+// Sui local patch: only pre-payload proxy establishment owns these deadlines.
+package dialer
+
+import (
+	"context"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"net"
+	"time"
+)
+
+type handshakeDialer struct{ N.Dialer }
+
+// WithHandshakeDeadline covers protocol readers which do not inspect context
+// after dialing (HTTP ReadResponse and SOCKS authentication/CONNECT reads).
+func WithHandshakeDeadline(upstream N.Dialer) N.Dialer {
+	return &handshakeDialer{upstream}
+}
+
+func (d *handshakeDialer) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	conn, err := d.Dialer.DialContext(ctx, network, destination)
+	if err != nil {
+		return nil, err
+	}
+	if deadline, exists := ctx.Deadline(); exists {
+		if err = conn.SetDeadline(deadline); err != nil {
+			conn.Close()
+			return nil, err
+		}
+	}
+	return conn, nil
+}
+
+// Handshake preserves an earlier inherited deadline. TCP connect, upstream TLS
+// and proxy authentication share five seconds, not five seconds per stage.
+// Clear the socket deadline only after success; the context is dial-only.
+func Handshake(ctx context.Context, upstream N.Dialer, network string, destination M.Socksaddr) (net.Conn, error) {
+	if N.NetworkName(network) != N.NetworkTCP {
+		return upstream.DialContext(ctx, network, destination)
+	}
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	conn, err := upstream.DialContext(ctx, network, destination)
+	if err != nil {
+		return nil, err
+	}
+	if err = conn.SetDeadline(time.Time{}); err != nil {
+		conn.Close()
+		return nil, err
+	}
+	return conn, nil
+}
