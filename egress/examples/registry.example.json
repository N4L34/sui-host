{
  "version": "example-1",
  "denied_networks": ["192.0.2.0/24", "2001:db8::/32"],
  "profiles": [
    {
      "id": "demo-pilot",
      "project": "demo",
      "service": "worker",
      "owner": "platform",
      "integration": "both",
      "mode": "pilot",
      "routes": [
        {
          "id": "example-api",
          "action": "PROXY",
          "matcher": {"kind": "exact", "value": "api.example.invalid"},
          "ports": [443],
          "upstream_group": "primary"
        },
        {
          "id": "example-static",
          "action": "DIRECT",
          "matcher": {"kind": "suffix", "value": "static.example.invalid"},
          "ports": [443]
        },
        {
          "id": "documentation-network",
          "action": "DENY",
          "matcher": {"kind": "cidr", "value": "198.51.100.0/24"},
          "ports": [80, 443]
        }
      ]
    }
  ]
}
