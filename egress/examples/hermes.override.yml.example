# REVIEW TEMPLATE ONLY. Not a deployable migration or evidence of enforcement.
# Requires accepted gateway, locally reviewed ingress IPAM and runtime testing.
# Existing Hermes Compose is unchanged. ALL_PROXY is deliberately emptied to
# remove its inherited authenticated SOCKS URI; test every SDK/tool separately.
services:
  hermes:
    environment:
      HTTP_PROXY: http://sui-egress:3128
      HTTPS_PROXY: http://sui-egress:3128
      http_proxy: http://sui-egress:3128
      https_proxy: http://sui-egress:3128
      ALL_PROXY: ""
      all_proxy: ""
      NO_PROXY: localhost,127.0.0.1,::1,hermes
      no_proxy: localhost,127.0.0.1,::1,hermes
    dns:
      - ${EGRESS_DNS_IP:?locally approved managed DNS address required}
    networks:
      monitoring: {}
      egress_hermes:
        ipv4_address: ${EGRESS_HERMES_IP:?locally approved stable ingress address required}

networks:
  monitoring:
    external: true
    name: monitoring
  egress_hermes:
    external: true
    name: egress_hermes
