# Copy to .env on the appliance. Do not commit .env.
MATRIX_SERVER_NAME=sui.example.com
TZ=Europe/Moscow
TELEGRAM_API_IP=149.154.167.220

# Chat keeps its own secrets. The platform only reads the two files it needs.
CHAT_SECRETS=/home/sui/tailnet-messenger/secrets
TEXTFILE=/home/sui/tailnet-messenger/deploy/rendered/textfile

PROMETHEUS_IMAGE=prom/prometheus:v3.4.0
GRAFANA_IMAGE=grafana/grafana:12.0.2
LOKI_IMAGE=grafana/loki:3.4.2
ALLOY_IMAGE=grafana/alloy:v1.8.1
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.0
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.0
CADVISOR_IMAGE=ghcr.io/google/cadvisor:v0.60.6
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.17.1
BLACKBOX_IMAGE=prom/blackbox-exporter:v0.25.0
