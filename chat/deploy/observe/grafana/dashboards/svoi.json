      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 87 },
      "panels": []
    },
    {
      "type": "logs",
      "id": 47,
      "title": "error / panic / fatal",
      "datasource": "Loki",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 88 },
