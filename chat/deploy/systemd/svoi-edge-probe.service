[Unit]
Description=Svoi public path and call checks
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=sui
Group=sui
SupplementaryGroups=docker
WorkingDirectory=/home/sui/sui-host/chat
ExecStart=/usr/bin/python3 /home/sui/sui-host/chat/scripts/telegram_notify.py probe
