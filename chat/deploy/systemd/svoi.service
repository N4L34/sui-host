[Unit]
Description=Svoi Matrix stack
After=docker.service tailscaled.service network-online.target
Requires=docker.service
Wants=tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=sui
Group=sui
SupplementaryGroups=docker
WorkingDirectory=/home/sui/sui-host/chat
ExecStart=/bin/bash -c 'set -euo pipefail; export TAILSCALE_IPV4="$(tr -d "[:space:]" < secrets/tailscale_ipv4)"; exec docker compose --env-file .env -f deploy/compose.yml -f deploy/compose.calls.yml -f deploy/rendered/compose.dial.yml -f deploy/compose.platform-net.yml up -d'
ExecStartPost=/usr/bin/make serve
ExecStop=/bin/bash -c 'set -euo pipefail; export TAILSCALE_IPV4="$(tr -d "[:space:]" < secrets/tailscale_ipv4)"; exec docker compose --env-file .env -f deploy/compose.yml -f deploy/compose.calls.yml -f deploy/rendered/compose.dial.yml -f deploy/compose.platform-net.yml stop'
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
