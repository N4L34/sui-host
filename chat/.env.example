# Copy to .env. Values are shell-sourced. Quote anything with spaces.
# MATRIX_SERVER_NAME is the MagicDNS name of THIS node, lowercase, no scheme.
# Example: messenger.example.com
# It becomes the Matrix server name (@alice:MATRIX_SERVER_NAME) and cannot change later.
MATRIX_SERVER_NAME=messenger.example.com

# Image tags. Bump deliberately after a backup. Record digests with: make pin
SYNAPSE_IMAGE=ghcr.io/element-hq/synapse:v1.163.0
POSTGRES_IMAGE=postgres:17-alpine
ELEMENT_WEB_IMAGE=ghcr.io/element-hq/element-web:v1.12.32
ALPINE_IMAGE=alpine:3.22

# Optional profiles. Core chat does not need these.
ENABLE_CALLS=false
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.10
LK_JWT_IMAGE=ghcr.io/element-hq/lk-jwt-service:latest
CADDY_IMAGE=caddy:2.10-alpine

# Observe profile (make observe). 8 GB RAM recommended when this is on.
PROMETHEUS_IMAGE=prom/prometheus:v3.4.0
GRAFANA_IMAGE=grafana/grafana:12.0.2
LOKI_IMAGE=grafana/loki:3.4.2
ALLOY_IMAGE=grafana/alloy:v1.8.1
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.0
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.0
CADVISOR_IMAGE=ghcr.io/google/cadvisor:v0.60.6
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.17.1
BLACKBOX_IMAGE=prom/blackbox-exporter:v0.25.0

ELEMENT_BRAND='Свои'
TZ=Europe/Moscow

# Offsite backups. Empty means local tarballs only (not enough: the disk is the server).
# Examples: /mnt/usb/svoi-restic    sftp:backup@nas:/srv/restic/svoi
RESTIC_REPOSITORY=
# Set to a webhook (ntfy, etc.) if you want Alertmanager to shout. Empty drops alerts after logging.
# Telegram uses secrets/telegram_bot_token and secrets/telegram_chat_id instead of this URL.
ALERT_WEBHOOK_URL=
# DNS for api.telegram.org is blackholed on the home link. This address answered
# with a valid certificate for that name. Alertmanager, the morning note, and
# the command bot use it.
# svoi-telegram-bot answers private admins of the alert chat. Passwords stay
# in that private chat. See docs/guides/operator.md.
TELEGRAM_API_IP=149.154.167.220
