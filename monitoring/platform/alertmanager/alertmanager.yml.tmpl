global:
  resolve_timeout: 5m

route:
  receiver: telegram
  group_by: [alertname, project]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: telegram
    telegram_configs:
      - bot_token_file: /etc/alertmanager/telegram_token
        chat_id: __TELEGRAM_CHAT_ID__
        api_url: https://api.telegram.org
        parse_mode: ""
        message: '{{ template "svoi.telegram" . }}'

templates:
  - /etc/alertmanager/telegram.tmpl
