{
  "services": [
    {
      "match": "chat-synapse-1",
      "project": "chat",
      "service": "synapse",
      "dns": "synapse",
      "name": "Чат",
      "alert": "page",
      "summary": "Чат не отвечает уже больше 2 минут.",
      "resolved": "Чат снова отвечает.",
      "probes": [
        "http://synapse:8008/health",
        "http://synapse:8008/_matrix/client/versions"
      ],
      "metrics_port": "9090",
      "metrics_path": "/_synapse/metrics"
    },
    {
      "match": "chat-element-web-1",
      "project": "chat",
      "service": "element-web",
      "dns": "element-web",
      "name": "Element",
      "probes": ["http://element-web:80/"]
    },
    {
      "match": "chat-livekit-1",
      "project": "chat",
      "service": "livekit",
      "dns": "livekit",
      "name": "Звонки",
      "probes": ["http://livekit:7880/"],
      "metrics_port": "6789",
      "metrics_path": "/metrics"
    },
    {
      "match": "chat-lk-jwt-1",
      "project": "chat",
      "service": "lk-jwt",
      "dns": "lk-jwt",
      "name": "Токены звонка",
      "probes": ["http://lk-jwt:8080/healthz"]
    },
    {
      "match": "chat-calls-proxy-1",
      "project": "chat",
      "service": "calls-proxy",
      "dns": "calls-proxy",
      "name": "Прокси звонков",
      "probes": ["http://calls-proxy:80/"]
    }
  ]
}
